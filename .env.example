TYPESAFE_API_KEY="your-api-key"

# LLM generador (el que escribe el SQL). La key se crea en https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# Opcional: otro modelo en formato "proveedor:modelo" de LangChain (default: openai:gpt-5-nano, el más barato)
# BONFIRE_MODEL=openai:gpt-6-sol

# Postgres (docker-compose.yml). bonfire_admin es el superusuario de la imagen:
# solo para init.sql y tests de permisos, nunca lo carga la app.
BONFIRE_ADMIN_PASSWORD=change-me
BONFIRE_AGENT_PASSWORD=change-me
# Puerto del host. Cambialo si ya tenés otro Postgres en 5432 (y ajustá los DSN).
BONFIRE_DB_PORT=5432

# La app carga solo AGENT_DSN. Mismas contraseñas que arriba.
AGENT_DSN=postgresql://bonfire_agent:change-me@127.0.0.1:5432/olist
ADMIN_DSN=postgresql://bonfire_admin:change-me@127.0.0.1:5432/olist

# Langfuse Cloud (trazas y experimentos). Keys del proyecto en Settings -> API Keys.
# Sin LANGFUSE_PUBLIC_KEY el agente no se traza y no hay tráfico a Langfuse.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# https://cloud.langfuse.com (EU) o https://us.cloud.langfuse.com (US), según dónde creaste el proyecto
LANGFUSE_BASE_URL=https://cloud.langfuse.com
